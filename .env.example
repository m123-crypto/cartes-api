# Copier en .env et remplacer chaque secret (32 caractères minimum).
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cartes:cartes@localhost:5432/cartes

JWT_SECRET=remplacer-par-un-secret-de-32-caracteres-minimum
OTP_SECRET=remplacer-par-un-autre-secret-de-32-caracteres-min
MOMO_WEBHOOK_SECRET=remplacer-secret-webhook-mobile-money-32-car
ISSUER_WEBHOOK_SECRET=remplacer-secret-webhook-emetteur-32-caract
ADMIN_API_KEY=remplacer-cle-back-office-32-caracteres-minimum

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Développement uniquement : renvoie le code OTP dans la réponse et active les
# routes /v1/sandbox/* qui simulent l'opérateur mobile money et l'émetteur.
# Refusés au démarrage si NODE_ENV=production.
OTP_DEV_ECHO=true
SANDBOX=true
